---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Lines from "./Lines.astro";
import { content, contactInfo, type Lang } from "../i18n/content";
import { image } from "../i18n/images";
import { pageUrl } from "../i18n/links";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const a = t.anchors;
const n = (index: number) => String(index + 1).padStart(2, "0");
---
<Layout lang={lang} page="home" title={t.meta.homeTitle} description={t.meta.homeDescription}>
  <section class="hero" id={a.top}>
    <div class="hero-copy">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1><Lines lines={t.hero.title} emphasis /></h1>
      <p class="intro">{t.hero.intro}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={`#${a.projects}`}>{t.hero.primary} <span aria-hidden="true">↓</span></a>
        <a class="text-link" href={`#${a.about}`}>{t.hero.secondary}</a>
      </div>
    </div>
    <div class="network-art brand-grid" aria-hidden="true">
      <span class="brand-c c-one"></span>
      <span class="brand-c c-two"></span>
      <Image class="hero-people" src={image("brand/community-people")} alt="" widths={[640, 1000, 1400]} sizes="(max-width: 1000px) 100vw, 50vw" loading="eager" />
      <span class="grid-zone">ZONA<br /><b>09</b></span>
    </div>
  </section>

  <div class="ticker" aria-label={t.territory.label}>
    {t.territory.places.map((place, index) => <Fragment>{index > 0 && <i></i>}<span>{place}</span></Fragment>)}
  </div>

  <section class="about" id={a.about}>
    <div class="section-label">{t.about.label}</div>
    <div class="about-main">
      <h2><Lines lines={t.about.title} /></h2>
      <div class="about-copy">
        <p class="lead">{t.about.lead}</p>
        <p>{t.about.text}</p>
      </div>
    </div>
    <div class="objective-grid">
      {t.about.objectives.map((objective, index) => <article><span>{n(index)}</span><p>{objective}</p></article>)}
    </div>
  </section>

  <section class="projects-section" id={a.projects}>
    <div class="section-label light">{t.projects.label}</div>
    <div class="projects-heading">
      <h2><Lines lines={t.projects.title} /></h2>
      <p>{t.projects.intro}</p>
    </div>
    <article class="nova-feature">
      <div class="nova-image">
        <Image src={image("nova-essencia/espai-cotreball")} alt={t.projects.featured.imageAlt} widths={[640, 1000]} sizes="(max-width: 1000px) 100vw, 50vw" />
        <span class="nova-project-logo" aria-hidden="true"><Image src={image("nova-essencia/logo")} alt="" width={400} /></span>
      </div>
      <div class="nova-copy">
        <p class="project-tag">{t.projects.featured.tag}</p>
        <h3>Nova<br />Essència</h3>
        {t.projects.featured.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <a href={pageUrl(lang, "nova")}>{t.projects.featured.cta} <span aria-hidden="true">→</span></a>
      </div>
    </article>
    <div class="project-grid">
      {t.projects.networks.map((network, index) => (
        <article class="project-card">
          <div class="project-top"><span>{n(index)}</span><Image src={image(`projects/${network.image}`)} alt="" /></div>
          <p class="project-area">{network.area}</p>
          <h3>{network.name}</h3>
          <p>{network.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="concepts" id="conceptes">
    <div class="section-label">{t.concepts.label}</div>
    <div class="concepts-heading">
      <h2><Lines lines={t.concepts.title} /></h2>
      <p>{t.concepts.intro}</p>
    </div>
    <div class="concept-grid">
      {t.concepts.items.map((item, index) => <article><span>{n(index)}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
    </div>
  </section>

  <section class="committee-section" id={a.committee}>
    <div class="section-label light">{t.committee.label}</div>
    <div class="committee-heading">
      <h2><Lines lines={t.committee.title} /></h2>
      <p>{t.committee.intro}</p>
    </div>
    <div class="committee-grid">
      {t.committee.members.map((member) => (
        <article class="committee-card">
          <div class="logo-stage"><Image src={image(`committee/${member.logo}`)} alt={t.committee.logoAlt(member.name)} width={320} /></div>
          <h3>{member.name}</h3>
          <p>{member.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="contact-section" id={a.contact}>
    <div>
      <p class="section-label">{t.contact.label}</p>
      <h2>{t.contact.title}</h2>
    </div>
    <div class="contact-details">
      <p><Lines lines={t.contact.address} /></p>
      <a href={`mailto:${contactInfo.email}`}>{contactInfo.email}</a>
      <a href={`tel:${contactInfo.phone}`}>{contactInfo.phoneLabel}</a>
      <a href={contactInfo.instagram} target="_blank" rel="noreferrer">{contactInfo.instagramLabel} ↗</a>
    </div>
  </section>
</Layout>
